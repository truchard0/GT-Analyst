# Copy to .env and fill in. All optional — RSS-only ingestion works with no keys.

# newsapi.org free tier (business headlines; polled every 3rd ingest run)
NEWSAPI_KEY=

# finnhub.io free tier (market news; polled every 3rd ingest run)
FINNHUB_KEY=

# Full path to the claude CLI — required for watchlist auto-trigger.
# Install: npm install -g @anthropic-ai/claude-code   then: where.exe claude
# Example: CLAUDE_BIN=C:\Users\you\AppData\Roaming\npm\claude.cmd
CLAUDE_BIN=

# Telegram phone notifications (fired when an auto-tier analysis runs).
# 1) Message @BotFather in Telegram -> /newbot -> copy the token below.
# 2) Message your new bot "hi", then run: python tools/telegram_setup.py  to get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
